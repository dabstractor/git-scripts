#!/usr/bin/env zsh

# commit-pi - AI commit message generator using pi (pi.dev) + z.ai GLM.
#
# Ported from commit-claude. Differences:
#   - Uses `pi` instead of `claude` (pi has a first-class `zai` provider, so no
#     GLM env/anthropic-compat proxy is needed).
#   - `--no-session` => this commit NEVER contributes to a saved session
#     (fully ephemeral), as required for the pipeline.
#   - `--no-tools/--no-extensions/--no-skills/--no-prompt-templates/--no-context-files`
#     replace CC's `--setting-sources "" --tools "" --disable-slash-commands --no-chrome`
#     to give a bare, settings-free, tool-free model call.
#   - Default model: glm-5-turbo (fast/cheap, mirrors the old haiku default).
#     Override with PI_COMMIT_MODEL, e.g. PI_COMMIT_MODEL=glm-5.2.

# -------------------------------------------------------------------------
# ERROR HANDLER (RESCUE PROTOCOL)
# -------------------------------------------------------------------------
handle_error() {
    if [[ -n "$TREE_SHA" && -z "$NEW_COMMIT_SHA" ]]; then
        echo ""
        echo "❌ Commit generation failed."
        echo "------------------------------------------------------------"
        echo "Your files were safely snapshotted before generation."
        echo "Tree ID: $TREE_SHA"
        echo ""
        echo "To commit the originally staged files manually, run:"
        if [[ -n "$PARENT_SHA" ]]; then
            echo "  git commit-tree -p $PARENT_SHA -m \"Your manual message\" $TREE_SHA | xargs git update-ref HEAD"
        else
            echo "  git commit-tree -m \"Your manual message\" $TREE_SHA | xargs git update-ref HEAD"
        fi
        echo "------------------------------------------------------------"
    fi
    exit 1
}

trap 'handle_error' INT TERM

# -------------------------------------------------------------------------
# 1. CHECK FOR STAGED CHANGES
# -------------------------------------------------------------------------
# Get markdown diffs (100 lines per file max)
md_files=(${(f)"$(git diff --cached --name-only -- '*.md' '*.markdown' 2>/dev/null)"})
markdown_diff=""
for file in $md_files; do
    markdown_diff+="$(git diff --cached -- "$file" | head -n 100)"$'\n'
done

# Get non-markdown diffs (excluding lock files, etc.)
other_diff=$(git diff --cached \
  -- ':!*.lock' ':!package-lock.json' ':!pnpm-lock.yaml' \
     ':!*.snap' ':!*.map' ':!vendor/*' \
     ':!*.md' ':!*.markdown' \
  | head -c 300000)

diff="$markdown_diff$other_diff"
if [[ -z "$diff" ]]; then
    echo "No staged changes found."
    exit 1
fi

# Capture parent BEFORE write-tree to ensure consistency
PARENT_SHA=$(git rev-parse HEAD 2>/dev/null)

# -------------------------------------------------------------------------
# 2. IMMEDIATE SNAPSHOT (PLUMBING)
# -------------------------------------------------------------------------
TREE_SHA=$(git write-tree)
if [[ $? -ne 0 ]]; then
    echo "Failed to write tree. Make sure you have staged changes."
    exit 1
fi

# -------------------------------------------------------------------------
# 3. PREPARE PROMPT & JSON INSTRUCTIONS
# -------------------------------------------------------------------------
commit_count=$(git rev-list --count HEAD 2>/dev/null || echo "0")

# Strict instruction: No internal double quotes to allow safe regex parsing
json_instruction="Return valid JSON only. No markdown, no XML.
Format: {\"commit_message\": \"<message>\"}
For multiline messages, use literal \\n for newlines (e.g., \"subject\\n\\nbody\").
IMPORTANT: Do NOT use double quotes (\") inside the message text. Use single quotes instead if needed."

if [[ $commit_count -gt 1 ]]; then
    # Fetch full commit messages with separator
    examples=$(git log --format="---%n%B" -20 | sed '/^$/d' | head -100)
    has_multiline=$(echo "$examples" | awk '/^---$/{if(lines>1)found=1; lines=0; next} {lines++} END{print found+0}')

    multiline_rule="Only output a single-line subject (no body)."
    if [[ "$has_multiline" == "1" ]]; then
        multiline_rule="Only add a body (blank line + description) if the history shows multiline commits AND these changes truly warrant detailed explanation. Otherwise, use a single-line subject only."
    fi

    system_prompt="You are a commit message generator.
$json_instruction

Focus on the ESSENCE of the change (the intent/purpose), not specific implementation details like filenames or function names.

Match the tone and style of these recent commits:
$examples

CRITICAL: You MUST NOT copy or reuse ANY phrasing from the examples above. The examples show the STYLE to match - the format, tone, and conventions. But producing the same text you have seen is STRICTLY FORBIDDEN. Your output must be completely original wording that describes THIS specific change. Reusing example text is a critical failure.
$multiline_rule
Target ~50 characters for the subject line."
else
    system_prompt="You are a commit message generator.
$json_instruction

Focus on the ESSENCE of the change (the intent/purpose), not specific implementation details like filenames or function names.

Target 50 characters (~7 words). Format: type(scope): description"
fi

prompt="Generate a commit message for these changes:"

# Default model: glm-5-turbo (cheap/fast). Override via PI_COMMIT_MODEL.
model="${PI_COMMIT_MODEL:-glm-5-turbo}"

# -------------------------------------------------------------------------
# 4. GENERATION LOOP (WITH RETRY FOR DUPLICATES)
# -------------------------------------------------------------------------
max_duplicate_retries=3
duplicate_retry=0
commit_msg=""
rejected_messages=()

while [ $duplicate_retry -lt $max_duplicate_retries ]; do
    attempt=1
    max_attempts=2
    user_prompt="$prompt"

    # If retrying due to duplicate, add explicit rejection info
    if [[ ${#rejected_messages[@]} -gt 0 ]]; then
        rejected_list=$(printf '- %s\n' "${rejected_messages[@]}")
        user_prompt="Generate a commit message for these changes.

IMPORTANT: The following messages were REJECTED because they already exist in git history. You MUST generate something COMPLETELY DIFFERENT:
$rejected_list

Create an entirely new message with different wording."
    fi

    while [ $attempt -le $max_attempts ]; do
        if [[ "$VERBOSE" == "1" ]]; then echo "DEBUG: Attempt $attempt of $max_attempts (duplicate retry $duplicate_retry)"; fi

        # Run the API call - BARE MINIMUM: no tools, no skills, no extensions,
        # no context files, no chrome, NO SESSION (fully ephemeral).
        # pi reads the prompt from stdin (no positional arg), matching the old CC shape.
        response=$(printf '%s\n\n%s' "$diff" "$user_prompt" \
          | pi \
          --provider zai \
          --model "$model" \
          --system-prompt "$system_prompt" \
          --no-tools \
          --no-extensions \
          --no-skills \
          --no-prompt-templates \
          --no-context-files \
          --no-session \
          -p)

        if [[ "$VERBOSE" == "1" ]]; then echo "DEBUG: Raw Response: $response"; fi

        # PARSE JSON USING SED
        # 1. tr -d '\n'     -> Remove newlines to handle multi-line JSON output
        # 2. sed command    -> Capture text between "commit_message": " AND "
        # 3. Convert \n escape sequences to actual newlines
        commit_msg=$(echo "$response" | tr -d '\n' | sed -n 's/.*"commit_message"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
        commit_msg=$(printf '%b' "$commit_msg")

        # Trim leading/trailing whitespace from overall message
        commit_msg=$(echo "$commit_msg" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')

        if [[ -n "$commit_msg" ]]; then
            break
        else
            echo "⚠️  Received invalid JSON format. Retrying..."
            user_prompt="The previous response was not valid JSON. Please output STRICT valid JSON only: {\"commit_message\": \"message_here\"}"
            ((attempt++))
        fi
    done

    if [[ -z "$commit_msg" ]]; then
        echo "Error: Failed to extract commit message after $max_attempts attempts."
        handle_error
    fi

    # Check subject line (first line) against recent commit subjects
    commit_subject=$(echo "$commit_msg" | head -1)
    recent_subjects=$(git log --format="%s" -50 2>/dev/null)
    if echo "$recent_subjects" | grep -Fxq "$commit_subject"; then
        echo "⚠️  Generated duplicate subject: '$commit_subject'. Retrying with explicit rejection..."
        rejected_messages+=("$commit_subject")
        ((duplicate_retry++))
        commit_msg=""
    else
        # Success - not a duplicate
        break
    fi
done

# -------------------------------------------------------------------------
# 5. FINAL VALIDATION
# -------------------------------------------------------------------------

if [[ -z "$commit_msg" ]]; then
    echo "Error: Failed to generate unique commit message after $max_duplicate_retries duplicate retries."
    handle_error
fi

if [[ -n "$PARENT_SHA" ]]; then
    NEW_COMMIT_SHA=$(git commit-tree -p "$PARENT_SHA" -m "$commit_msg" "$TREE_SHA")
    
    if ! git update-ref HEAD "$NEW_COMMIT_SHA" "$PARENT_SHA"; then
        echo "Error: Could not update HEAD. The branch moved while we were generating."
        exit 1
    fi
else
    NEW_COMMIT_SHA=$(git commit-tree -m "$commit_msg" "$TREE_SHA")
    git update-ref HEAD "$NEW_COMMIT_SHA"
fi

echo "[$NEW_COMMIT_SHA] $commit_subject"
git --no-pager diff-tree --no-commit-id --name-status -r "$NEW_COMMIT_SHA"

trap - INT TERM
